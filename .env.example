# Auth0 Configuration
# Create an Auth0 account at https://auth0.com and create a Regular Web Application

# Your Auth0 Domain (e.g., dev-abc123.us.auth0.com)
AUTH0_DOMAIN=your-auth0-domain.auth0.com

# Your Auth0 Client ID
AUTH0_CLIENT_ID=your-client-id-here

# Your Auth0 Client Secret
AUTH0_CLIENT_SECRET=your-client-secret-here

# Application Secret Key (generate a random string)
# You can generate one with: python -c "import os; print(os.urandom(24).hex())"
SECRET_KEY=your-secret-key-here

# Application Settings
# Callback URL should be set in Auth0 dashboard to:
# - http://localhost:5000/callback
# - http://localhost:5001/callback
# - http://localhost:5002/callback
# (Add all ports you plan to use for different hospitals)

# Logout Redirect URL should be set in Auth0 dashboard to:
# - http://localhost:5000
# - http://localhost:5001
# - http://localhost:5002
